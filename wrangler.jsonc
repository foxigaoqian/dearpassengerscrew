{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dear-passengers-crew",
  "main": "src/entry.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/media/*",
      "/favicon.png"
    ]
  },
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dearpassengerscrew.com/*",
      "zone_name": "dearpassengerscrew.com"
    },
    {
      "pattern": "www.dearpassengerscrew.com/*",
      "zone_name": "dearpassengerscrew.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}
